{
  "name": "meetnippon",
  "version": "0.1.0",
  "private": true,
  "description": "MeetNippon — multi-tenant SaaS meeting-room & desk booking platform",
  "workspaces": [
    "apps/api",
    "apps/web-user",
    "apps/web-admin",
    "packages/shared"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @meetnippon/shared",
    "api:dev": "npm run start:dev --workspace @meetnippon/api",
    "api:build": "npm run build --workspace @meetnippon/api",
    "api:test": "npm run test --workspace @meetnippon/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @meetnippon/api",
    "prisma:seed": "npm run seed --workspace @meetnippon/api"
  },
  "engines": {
    "node": ">=20"
  }
}
