# ============================================================
# MeetNippon — environment (copy to .env, fill secrets)
# ============================================================

# --- Postgres (internal to compose network; NOT exposed to host) ---
POSTGRES_USER=meetnippon
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=meetnippon
# DATABASE_URL consumed by Prisma inside the api container
DATABASE_URL=postgresql://meetnippon:change_me_dev_only@db:5432/meetnippon?schema=public

# --- Redis (internal) ---
REDIS_URL=redis://redis:6379

# --- API ---
API_PORT=8081
NODE_ENV=development
# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Base domain for tenant subdomains (shared-URL mode works without wildcard DNS)
PLATFORM_BASE_DOMAIN=meetnippon.cosger.online
# Comma-separated public email domains blocked from tenant registration
PUBLIC_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,proton.me,aol.com

# --- Web apps ---
WEB_USER_PORT=8082
WEB_ADMIN_PORT=8083
# URL the browser uses to reach the API (proxied by nginx in prod)
NEXT_PUBLIC_API_URL=http://localhost:8081

# --- SMTP (dev = Mailpit; prod creds = escalation) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="MeetNippon <no-reply@meetnippon.cosger.online>"
