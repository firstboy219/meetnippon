// MeetNippon — Prisma schema. Implements BRD ch.9 (Model Data) + roadmap Phase 1.
// Multi-tenant: every tenant-owned table carries tenantId + composite indexes.
// Data isolation enforced at app layer (Prisma extension guard) — see src/prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================
enum UserRole {
  ADMIN
  APPROVER
  EMPLOYEE
}

enum Language {
  EN
  ID
}

enum Presence {
  AVAILABLE
  BUSY
  DND
  AWAY
  OFFLINE
}

enum DomainStatus {
  PENDING
  VERIFIED
}

enum AccessMode {
  SUBDOMAIN
  SHARED_URL
}

enum ResourceType {
  ROOM
  DESK
}

enum ResourceStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum PolicyScope {
  TENANT
  CATEGORY
  ROOM
}

enum BookingType {
  OFFLINE
  ONLINE
  HYBRID
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  WAITLIST
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum CallbackStatus {
  NONE
  PENDING
  SENT
  FAILED
}

enum RecordingStatus {
  PROCESSING
  READY
  EXPIRED
  NONE
}

enum WorkLocation {
  OFFICE
  WFH
  UNKNOWN
}

enum EmailTemplateType {
  INVITATION
  REMINDER
  CANCELLATION
}

// ============================================================
// TENANT & ONBOARDING
// ============================================================
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // internal handle
  /// IANA zone; the wall clock booking rules and displays are evaluated on.
  /// Defaults to UTC so existing rows keep their previous behaviour; new
  /// workspaces are created as Asia/Jakarta by onboarding.
  timezone    String   @default("UTC")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domains        TenantDomain[]
  branding       TenantBranding?
  mailSetting    TenantMailSetting?
  featureFlags   TenantFeatureFlag[]
  emailTemplates EmailTemplate[]
  apiKeys        TenantApiKey[]
  users          User[]
  officeLocations OfficeLocation[]
  buildings      Building[]
  resources      Resource[]
  policies       BookingPolicy[]
  bookings       Booking[]
  recordings     Recording[]
  conversations  ChatConversation[]
  notifications  Notification[]
  workLocationLogs WorkLocationLog[]
  auditLogs      AuditLog[]
  externalApprovalTasks ExternalApprovalTask[]
  subdomainRedirects SubdomainRedirect[]
}

model TenantDomain {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain            String       @unique // globally unique, lowercase
  status            DomainStatus @default(PENDING)
  verificationToken String       @default(cuid())
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())

  @@index([tenantId])
  @@index([domain])
}

model TenantBranding {
  id            String     @id @default(cuid())
  tenantId      String     @unique
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  displayName   String?
  primaryColor  String     @default("#0E6E55")
  accentColor   String     @default("#E4572E")
  logoUrl       String?
  loginBgUrl    String?
  accessMode    AccessMode @default(SHARED_URL)
  subdomain     String?    @unique // validated: [a-z0-9-], 3-30, global-unique, not reserved
  updatedAt     DateTime   @updatedAt
}

// old subdomain -> new subdomain redirect (BRD 6.4)
model SubdomainRedirect {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  oldSubdomain String   @unique
  newSubdomain String
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model TenantFeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String // e.g. "chat", "chat_external", "chat_group_creation", "deep_integration"
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model EmailTemplate {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      EmailTemplateType
  subject   String
  body      String
  updatedAt DateTime          @updatedAt

  @@unique([tenantId, type])
  @@index([tenantId])
}

model TenantApiKey {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label             String    @default("default")
  keyHash           String // argon2 hash of the API key; prefix stored for display
  keyPrefix         String // e.g. "sk_live_nipsea_...3f8a"
  allowedCategories Json      @default("[]") // BRD 7.14.5 category allowlist
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([tenantId])
  @@index([keyPrefix])
}

// ============================================================
// USERS
// ============================================================
model User {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String // unique within tenant — this is the login identity
  /// Optional personal/alternate address the user adds themselves. Contact
  /// only: it is deliberately NOT a login identity and NOT a recovery channel,
  /// because nothing verifies ownership of it.
  personalEmail String?
  fullName      String
  /// URL of an uploaded avatar; null falls back to initials.
  avatarUrl     String?
  passwordHash  String?
  role          UserRole  @default(EMPLOYEE)
  department    String?
  languagePref  Language  @default(EN)
  presence      Presence  @default(OFFLINE)
  presenceManual Boolean  @default(false) // true = user overrode auto presence
  presenceLocked Boolean  @default(false)
  isActive      Boolean   @default(true)
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookingsAsPrincipal Booking[] @relation("principal")
  bookingsAsBooker    Booking[] @relation("booker")
  chatMemberships     ChatMember[]
  messages            ChatMessage[]
  notifications       Notification[]
  workLocationLogs    WorkLocationLog[]
  approvalSteps       ApprovalStep[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, department])
}

// ============================================================
// LOCATION HIERARCHY (BRD 7.2, 7.13.1)
// ============================================================
/// Per-tenant outbound SMTP, configured from the admin console.
/// Falls back to the platform env defaults when absent.
model TenantMailSetting {
  id        String  @id @default(cuid())
  tenantId  String  @unique
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host      String
  port      Int     @default(587)
  username  String  @default("")
  /// AES-256-GCM ciphertext (iv:tag:data, base64). Never returned by the API.
  passwordEnc String @default("")
  fromName  String?
  fromEmail String?
  enabled   Boolean @default(true)
  /// Outcome of the last real connection attempt, for the admin console.
  lastVerifiedAt DateTime?
  lastError      String?
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model OfficeLocation {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  lat            Float?
  lng            Float?
  geofenceRadiusM Int     @default(150)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  buildings Building[]

  @@index([tenantId])
}

model Building {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  officeLocationId String?
  officeLocation   OfficeLocation? @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)
  name             String
  createdAt        DateTime        @default(now())

  floors Floor[]

  @@index([tenantId])
  @@index([officeLocationId])
}

model Floor {
  id         String   @id @default(cuid())
  tenantId   String
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String
  siteContacts Json   @default("[]") // BRD 7.2 site contact (reception/facility/security)
  createdAt  DateTime @default(now())

  floorPlan FloorPlan?
  resources Resource[]

  @@index([tenantId])
  @@index([buildingId])
}

model FloorPlan {
  id        String   @id @default(cuid())
  tenantId  String
  floorId   String   @unique
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  imageUrl  String?
  pins      Json     @default("[]") // [{resourceId,x,y}]
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// room OR desk (BRD 7.2)
model Resource {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  floorId    String?
  floor      Floor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  type       ResourceType
  name       String
  category   String? // e.g. "VIP Room" — used for policy category scope
  capacity   Int            @default(1)
  facilities Json           @default("[]") // ["Projector","VC",...]
  zone       String? // neighborhood/zone for hot-desk
  status     ResourceStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  bookings Booking[]
  policies BookingPolicy[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, category])
}

// ============================================================
// RULE / POLICY ENGINE (BRD 7.3) — 3-level override
// ============================================================
model BookingPolicy {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope      PolicyScope
  category   String? // when scope=CATEGORY
  resourceId String? // when scope=ROOM
  resource   Resource?   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  // rules stored as jsonb; resolver merges TENANT<-CATEGORY<-ROOM (BRD 7.3.1-7.3.6)
  rules      Json        @default("{}")
  updatedAt  DateTime    @updatedAt

  @@unique([tenantId, scope, category, resourceId])
  @@index([tenantId])
  @@index([tenantId, scope])
}

// ============================================================
// BOOKING (BRD 7.4)
// ============================================================
model Booking {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  type         BookingType   @default(OFFLINE)
  meetingLink  String?
  resourceId   String?
  resource     Resource?     @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  principalId  String // booking owner
  principal    User          @relation("principal", fields: [principalId], references: [id], onDelete: Cascade)
  bookerId     String // who created it (delegate) — BRD 7.4.5
  booker       User          @relation("booker", fields: [bookerId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  status       BookingStatus @default(PENDING)
  participants Json          @default("[]") // [{userId?,email,external:bool}]
  reminders    Json          @default("[]") // [{offsetMinutes,channel}]
  /// Offsets already delivered, so a dispatcher tick cannot send twice.
  remindersSent Json         @default("[]")
  recordingRequested Boolean @default(false)
  recurringGroupId String?
  checkInToken String?       @unique
  checkedInAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  approvalSteps ApprovalStep[]
  recording     Recording?
  conversation  ChatConversation?

  @@index([tenantId])
  @@index([tenantId, resourceId, startTime])
  @@index([tenantId, principalId])
  @@index([recurringGroupId])
}

model ApprovalStep {
  id         String           @id @default(cuid())
  tenantId   String
  bookingId  String
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  level      Int              @default(1)
  approverId String?
  approver   User?            @relation(fields: [approverId], references: [id], onDelete: SetNull)
  decision   ApprovalDecision @default(PENDING)
  note       String?
  decidedAt  DateTime?
  createdAt  DateTime         @default(now())

  @@index([tenantId])
  @@index([bookingId])
}

// ============================================================
// UNIVERSAL APPROVAL HUB (BRD 7.14)
// ============================================================
model ExternalApprovalTask {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       String
  title          String
  body           String?
  requesterName  String?
  sourcePlatform String?
  approverEmail  String // mapped to a user
  decision       ApprovalDecision @default(PENDING)
  note           String?
  callbackUrl    String?
  callbackStatus CallbackStatus   @default(NONE)
  callbackAttempts Int            @default(0)
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, approverEmail])
}

// ============================================================
// RECORDING (BRD 7.8)
// ============================================================
model Recording {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingId   String          @unique
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status      RecordingStatus @default(NONE)
  mediaUrl    String?
  transcript  String?
  retentionUntil DateTime?
  createdAt   DateTime        @default(now())

  @@index([tenantId])
}

// ============================================================
// CHAT (BRD 7.12)
// ============================================================
model ChatConversation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isGroup   Boolean  @default(false)
  name      String?
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatMember[]
  messages ChatMessage[]

  @@index([tenantId])
}

model ChatMember {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  muted          Boolean          @default(false)
  /// How far this member has read. Unread = messages after this instant.
  lastReadAt     DateTime?
  /// When we last emailed them about unread messages here, so a burst of
  /// messages produces one nudge rather than one per message.
  lastNotifiedAt DateTime?
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([tenantId])
  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  isBot          Boolean          @default(false)
  body           String
  attachments    Json             @default("[]")
  readBy         Json             @default("[]")
  reactions      Json             @default("[]")
  cardData       Json? // actionable bot cards (approval/checkin)
  createdAt      DateTime         @default(now())

  @@index([tenantId])
  @@index([conversationId, createdAt])
}

// ============================================================
// NOTIFICATION (BRD 7.6.1)
// ============================================================
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // reminder | approval | mention | recording_ready | domain_verify | ops
  title     String
  deepLink  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId, isRead])
}

// ============================================================
// WFH DETECTION (BRD 7.13) — category only, no precise coords
// ============================================================
model WorkLocationLog {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          DateTime     @db.Date
  location     WorkLocation @default(UNKNOWN)
  officeName   String? // only the matched office name, never raw GPS
  createdAt    DateTime     @default(now())

  @@unique([userId, day])
  @@index([tenantId, day])
}

// ============================================================
// AUDIT LOG
// ============================================================
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String // e.g. "booking.create", "policy.update"
  entity    String?
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
}
